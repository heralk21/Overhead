{
  "component": "Cinematic/Hero-Flight-Ticket",
  "figmaFrame": "Reel/Cinematic/08-Hero-Ticket",
  "canvas": { "width": 1920, "height": 1080, "unit": "pt" },
  "featuredFlight": "aca873",
  "description": "Climax artifact — reference's journey ticket adapted for Overhead. Gradient flight pass with LED callsign, route, and live stats.",

  "layout": {
    "composition": "Ticket card left-of-center (~42% from left), tagline block right third",
    "ticketPosition": { "x": 280, "y": 290 },
    "ticketSize": { "width": 360, "height": 520 },
    "taglinePosition": { "x": 1180, "y": 420 }
  },

  "layers": [
    {
      "name": "BG/Canvas",
      "type": "frame-fill",
      "size": "1920×1080",
      "fill": "#000000"
    },
    {
      "name": "BG/Radial-Glow",
      "type": "ellipse",
      "position": { "x": 500, "y": 540 },
      "size": { "width": 900, "height": 900 },
      "fill": "radial-gradient",
      "gradient": {
        "type": "radial",
        "stops": [
          { "position": 0, "color": "#0A0F1A", "opacity": 0.9 },
          { "position": 0.5, "color": "#0A0F1A", "opacity": 0.4 },
          { "position": 1, "color": "#000000", "opacity": 1 }
        ]
      },
      "blur": 0
    },
    {
      "name": "BG/Rim-Light-Left",
      "type": "rectangle",
      "position": { "x": 0, "y": 0 },
      "size": { "width": 4, "height": 1080 },
      "fill": "#73B8EB",
      "opacity": 0.35,
      "blur": 8
    },
    {
      "name": "Ticket/Shell",
      "type": "group",
      "position": { "x": 280, "y": 290 },
      "size": { "width": 360, "height": 520 },
      "children": "see ticketShell below"
    },
    {
      "name": "Tagline/With-Overhead",
      "type": "text",
      "position": { "x": 1180, "y": 420 },
      "content": "With Overhead",
      "font": "SF Pro Text",
      "size": 18,
      "weight": 400,
      "color": "rgba(255,255,255,0.50)",
      "letterSpacing": 0
    },
    {
      "name": "Tagline/Headline",
      "type": "text",
      "position": { "x": 1180, "y": 452 },
      "content": "Every flight,\nidentified",
      "font": "SF Pro Display",
      "size": 48,
      "weight": 700,
      "color": "#FFFFFF",
      "lineHeight": 1.1,
      "maxWidth": 420
    },
    {
      "name": "Tagline/Actions",
      "type": "group",
      "position": { "x": 1180, "y": 580 },
      "children": [
        {
          "name": "Button/Back-to-Map",
          "size": { "width": 168, "height": 44 },
          "fill": "rgba(255,255,255,0.07)",
          "stroke": "rgba(255,255,255,0.12)",
          "strokeWidth": 0.5,
          "cornerRadius": 22,
          "icon": "map.fill",
          "iconSize": 15,
          "label": "Back to Map",
          "labelFont": "SF Pro Text 14 Medium",
          "labelColor": "#FFFFFF"
        },
        {
          "name": "Button/Share-Flight",
          "offset": { "x": 180, "y": 0 },
          "size": { "width": 168, "height": 44 },
          "fill": "rgba(255,255,255,0.07)",
          "stroke": "rgba(255,255,255,0.12)",
          "strokeWidth": 0.5,
          "cornerRadius": 22,
          "icon": "square.and.arrow.up",
          "iconSize": 15,
          "label": "Share Flight",
          "labelFont": "SF Pro Text 14 Medium",
          "labelColor": "#FFFFFF"
        }
      ]
    },
    {
      "name": "Brand/Footer",
      "type": "group",
      "position": { "x": 1180, "y": 980 },
      "children": [
        {
          "name": "Brand/Logo-Mark",
          "asset": "assets/app-icon/overhead-logo.png",
          "size": 24
        },
        {
          "name": "Brand/Name",
          "offset": { "x": 32, "y": 2 },
          "content": "Overhead",
          "font": "SF Pro Text 14 Medium",
          "color": "rgba(255,255,255,0.50)"
        }
      ]
    }
  ],

  "ticketShell": {
    "name": "Ticket/Shell",
    "size": { "width": 360, "height": 520 },
    "cornerRadius": 24,
    "cornerStyle": "continuous",
    "ticketNotches": {
      "enabled": true,
      "positionYPercent": 0.38,
      "notchRadius": 14,
      "sides": ["left", "right"],
      "fill": "#000000",
      "note": "Subtract semicircles from left/right edges at 38% height for perforated ticket look"
    },
    "fill": {
      "type": "linear-gradient",
      "angle": 180,
      "stops": [
        { "position": 0, "color": "#73B8EB", "opacity": 1 },
        { "position": 0.35, "color": "#3D8FCC", "opacity": 1 },
        { "position": 0.65, "color": "#1A3A5C", "opacity": 1 },
        { "position": 1, "color": "#0A0F1A", "opacity": 1 }
      ]
    },
    "stroke": {
      "color": "rgba(255,255,255,0.12)",
      "width": 0.5,
      "position": "inside"
    },
    "shadow": {
      "color": "rgba(0,0,0,0.45)",
      "x": 0,
      "y": 24,
      "blur": 48
    },
    "innerPadding": { "top": 28, "right": 28, "bottom": 28, "left": 28 },

    "sections": [
      {
        "name": "Ticket/Header",
        "height": 72,
        "children": [
          {
            "name": "Ticket/Badge-Sparkle",
            "type": "circle",
            "size": 28,
            "position": "top-center",
            "offsetY": 0,
            "fill": "rgba(10,15,26,0.65)",
            "icon": "sparkle or radar icon, white 14pt",
            "note": "Small dark circle with white ✦ or radar pulse — reference uses AI sparkle; use radar motif for Overhead"
          },
          {
            "name": "Ticket/Logo",
            "type": "image",
            "asset": "assets/airline-logos/air_canada.png",
            "size": 48,
            "position": { "x": "center", "y": 36 }
          }
        ]
      },
      {
        "name": "Ticket/Callsign-Block",
        "paddingTop": 8,
        "children": [
          {
            "name": "Ticket/Callsign-LED",
            "type": "svg-import",
            "asset": "led-font/words/quick-callsign-aca873-6.5pt.svg",
            "fallbackText": "ACA873",
            "fallbackFont": "SF Pro Display 32 Bold",
            "color": "#FFFFFF",
            "alignment": "center",
            "height": 45.5
          },
          {
            "name": "Ticket/Airline",
            "type": "text",
            "content": "AIR CANADA",
            "font": "SF Pro Text 13 Semibold",
            "color": "#EB4747",
            "alignment": "center",
            "paddingTop": 6
          }
        ]
      },
      {
        "name": "Ticket/Divider-1",
        "type": "line",
        "marginTop": 20,
        "marginBottom": 20,
        "marginHorizontal": 0,
        "height": 0.5,
        "color": "rgba(255,255,255,0.20)"
      },
      {
        "name": "Ticket/Route-Row",
        "type": "h-stack",
        "justify": "space-between",
        "children": [
          {
            "name": "Ticket/Dep",
            "type": "v-stack",
            "children": [
              { "name": "Label", "text": "FROM", "font": "SF Pro Text 10 Medium", "color": "rgba(255,255,255,0.50)", "uppercase": true },
              { "name": "Code", "text": "YVR", "font": "SF Pro Display 36 Bold", "color": "#FFFFFF", "paddingTop": 4 }
            ]
          },
          {
            "name": "Ticket/Route-Icon",
            "type": "icon",
            "symbol": "airplane",
            "size": 20,
            "color": "rgba(255,255,255,0.50)",
            "rotation": 90
          },
          {
            "name": "Ticket/Arr",
            "type": "v-stack",
            "alignment": "trailing",
            "children": [
              { "name": "Label", "text": "TO", "font": "SF Pro Text 10 Medium", "color": "rgba(255,255,255,0.50)", "uppercase": true },
              { "name": "Code", "text": "YYZ", "font": "SF Pro Display 36 Bold", "color": "#FFFFFF", "paddingTop": 4 }
            ]
          }
        ]
      },
      {
        "name": "Ticket/Divider-2",
        "type": "line",
        "marginTop": 20,
        "marginBottom": 16,
        "height": 0.5,
        "color": "rgba(255,255,255,0.20)"
      },
      {
        "name": "Ticket/Stats-Grid",
        "type": "grid",
        "columns": 2,
        "rowGap": 16,
        "columnGap": 24,
        "children": [
          {
            "name": "Stat/Altitude",
            "label": "ALTITUDE",
            "value": "35,000 FT",
            "labelStyle": "SF Pro Text 10 Medium uppercase rgba(255,255,255,0.50)",
            "valueStyle": "SF Pro Text 15 Semibold #FFFFFF"
          },
          {
            "name": "Stat/Status",
            "label": "STATUS",
            "value": "HI-ALT",
            "valueColor": "#FFFFFF"
          },
          {
            "name": "Stat/Speed",
            "label": "SPEED",
            "value": "478 KT"
          },
          {
            "name": "Stat/Heading",
            "label": "HEADING",
            "value": "270° W"
          }
        ]
      },
      {
        "name": "Ticket/Divider-3",
        "type": "line",
        "marginTop": 20,
        "marginBottom": 16,
        "height": 0.5,
        "color": "rgba(255,255,255,0.20)"
      },
      {
        "name": "Ticket/Footer-Row",
        "type": "h-stack",
        "justify": "space-between",
        "align": "center",
        "children": [
          {
            "name": "Ticket/Aircraft-Type",
            "text": "B737-800",
            "font": "SF Pro Text 12 Medium",
            "color": "rgba(255,255,255,0.70)"
          },
          {
            "name": "Ticket/Registration",
            "text": "C-FRSR",
            "font": "SF Pro Text 12 Medium monospaced",
            "color": "rgba(255,255,255,0.50)"
          }
        ]
      },
      {
        "name": "Ticket/Chips",
        "type": "h-stack",
        "gap": 8,
        "marginTop": 16,
        "children": [
          {
            "name": "Chip/Narrow-Body",
            "text": "NARROW-BODY",
            "font": "SF Pro Text 9 Medium uppercase",
            "padding": { "h": 10, "v": 5 },
            "cornerRadius": 10,
            "fill": "rgba(255,255,255,0.10)",
            "stroke": "rgba(255,255,255,0.20)",
            "strokeWidth": 0.5,
            "color": "#FFFFFF"
          },
          {
            "name": "Chip/Live",
            "text": "● LIVE",
            "font": "SF Pro Text 9 Medium uppercase",
            "padding": { "h": 10, "v": 5 },
            "cornerRadius": 10,
            "fill": "rgba(97,209,148,0.15)",
            "stroke": "rgba(97,209,148,0.40)",
            "strokeWidth": 0.5,
            "color": "#61D194",
            "dotColor": "#61D194"
          }
        ]
      }
    ]
  },

  "jitterAnimation": {
    "entrance": {
      "duration": 1.2,
      "easing": "spring",
      "properties": [
        { "layer": "Ticket/Shell", "opacity": [0, 1], "scale": [0.88, 1], "rotateY": [-8, 0] },
        { "layer": "Tagline/Headline", "opacity": [0, 1], "x": [40, 0], "delay": 0.3 },
        { "layer": "Tagline/With-Overhead", "opacity": [0, 1], "delay": 0.2 }
      ]
    },
    "idle": {
      "gradientShimmer": { "layer": "Ticket/Shell fill", "duration": 4, "loop": true, "note": "Subtle gradient position shift or opacity pulse on top stop" },
      "liveDotPulse": { "layer": "Chip/Live dot", "opacity": [1, 0.4, 1], "duration": 1.5, "loop": true }
    }
  },

  "variants": [
    {
      "name": "Ticket/Hero-WJA158",
      "flight": "wja158",
      "callsignAsset": "led-font/words/quick-callsign-wja158-6.5pt.svg",
      "airlineLogo": "westjet",
      "airlineName": "WESTJET",
      "airlineColor": "#00A6A6",
      "route": "YVR → YYC",
      "status": "T/OFF",
      "statusColor": "#61D194",
      "altitude": "8,200 FT"
    }
  ]
}
